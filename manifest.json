{
  "id": "ibkr-multi-import",
  "name": "IBKR Multi-Currency Import",
  "version": "1.0.2",
  "description": "Import IBKR transactions via CSV files or Flex Query API with automatic multi-currency account creation",
  "author": "Nikolai Trukhin",
  "sdkVersion": "3.9.0",
  "minWealthfolioVersion": "3.9.0",
  "main": "dist/addon.js",
  "enabled": true,
  "contributes": {
    "routes": [
      { "id": "ibkr-multi-import" },
      { "id": "ibkr-flex-settings", "path": "settings" }
    ],
    "links": {
      "sidebar": [
        {
          "id": "ibkr-multi-import",
          "route": "ibkr-multi-import",
          "label": "IBKR Import",
          "icon": "arrows-down-up",
          "order": 100
        },
        {
          "id": "ibkr-flex-settings",
          "route": "ibkr-flex-settings",
          "label": "IBKR Settings",
          "icon": "gear",
          "order": 101
        }
      ]
    }
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": [
        { "name": "getAll", "isDeclared": true },
        { "name": "create", "isDeclared": true }
      ],
      "purpose": "Create and manage multi-currency accounts"
    },
    {
      "category": "activities",
      "functions": [
        { "name": "import", "isDeclared": true },
        { "name": "checkImport", "isDeclared": true },
        { "name": "getAll", "isDeclared": true },
        { "name": "search", "isDeclared": true },
        { "name": "create", "isDeclared": true },
        { "name": "update", "isDeclared": true },
        { "name": "saveMany", "isDeclared": true },
        { "name": "linkTransfer", "isDeclared": true },
        { "name": "unlinkTransfer", "isDeclared": true }
      ],
      "purpose": "Import and manage transactions from IBKR"
    },
    {
      "category": "market-data",
      "functions": [
        { "name": "searchTicker", "isDeclared": true },
        { "name": "sync", "isDeclared": true }
      ],
      "purpose": "Resolve ticker symbols from ISINs"
    },
    {
      "category": "portfolio",
      "functions": [
        { "name": "getHoldings", "isDeclared": true },
        { "name": "update", "isDeclared": true },
        { "name": "recalculate", "isDeclared": true }
      ],
      "purpose": "Update portfolio after import"
    },
    {
      "category": "secrets",
      "functions": [
        { "name": "get", "isDeclared": true },
        { "name": "set", "isDeclared": true },
        { "name": "delete", "isDeclared": true }
      ],
      "purpose": "Store IBKR Flex Query credentials"
    },
    {
      "category": "events",
      "functions": [
        { "name": "onUpdateComplete", "isDeclared": true }
      ],
      "purpose": "Trigger automatic Flex Query fetch on portfolio updates"
    },
    {
      "category": "network",
      "functions": [
        { "name": "request", "isDeclared": true }
      ],
      "purpose": "Fetch Flex Query data from IBKR API"
    },
    {
      "category": "settings",
      "functions": [
        { "name": "get", "isDeclared": true }
      ],
      "purpose": "Read app settings"
    },
    {
      "category": "files",
      "functions": [
        { "name": "openCsvDialog", "isDeclared": true }
      ],
      "purpose": "Open CSV file dialog for manual import"
    }
  ],
  "network": {
    "allowedHosts": ["ndcdyn.interactivebrokers.com"]
  },
  "hostDependencies": {
    "@wealthfolio/addon-sdk": "^3.9.0",
    "@wealthfolio/ui": "^3.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "homepage": "https://github.com/CoolONEOfficial/wealthfolio-ibkr-addon",
  "repository": "https://github.com/CoolONEOfficial/wealthfolio-ibkr-addon",
  "license": "MIT",
  "keywords": ["ibkr", "interactive-brokers", "import", "multi-currency", "flex-query"]
}
